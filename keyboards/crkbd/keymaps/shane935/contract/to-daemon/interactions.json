        { "do": "connect" },
        { "do": "context", "fields": { "seq": 1, "ack": 255, "os": 2, "program": 1, "tmuxBits": 3, "transcript": 0, "phase": 0, "perm": 0, "intentNonce": 0, "intentStatus": 0, "window": 0, "pane": 0, "label": "" } },
